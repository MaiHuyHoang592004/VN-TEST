# Copy to .env.local for local dev/tests. Never commit real secrets.
DATABASE_URL="postgresql://user:pass@localhost:5432/fulfillflow_local?schema=public"

# Shopify Partner Dashboard → app → Client credentials.
SHOPIFY_API_KEY="replace-with-shopify-client-id"
SHOPIFY_API_SECRET="replace-with-shopify-client-secret"
SHOPIFY_SCOPES="read_orders"
# This API's own public origin (not the shop's), used to build the OAuth redirect_uri.
SHOPIFY_APP_URL="https://your-app.example.com"
# 32 random bytes, base64-encoded — `openssl rand -base64 32`. Encrypts Store
# access tokens at rest (AES-256-GCM). Rotate via Store.tokenVersion, not by
# changing this key in place.
SHOPIFY_TOKEN_ENC_KEY="replace-with-base64-32-bytes"
