# Copy to .env.local and fill in. Prod values live in Vercel env vars.
AUTH_SECRET=""          # openssl rand -base64 32
AUTH_GOOGLE_ID=""       # Google Cloud Console OAuth client (Web application)
AUTH_GOOGLE_SECRET=""
RESEND_API_KEY=""         # resend.com "Ai_access" key (full account access) — the key the app uses
RESEND_API_KEY_SENDING="" # resend.com original send-only key (backup)
DATABASE_URL=""         # postgresql://user@host:5432/db?schema=public
AUTH_OTP_CONSOLE=""     # "1" locally = print OTP codes in the terminal instead of emailing (any address works). NEVER in prod.

# File storage (doc 05 A1). Unset locally → the local-disk driver writes to
# ./.uploads. Set STORAGE_DRIVER=local to force disk even when a token exists.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=

# Label carrier (doc 05 C5) — the feature hides itself when the key is absent.
KILOSHIPS_API_KEY=
KILOSHIPS_API_BASE_URL=
KILOSHIPS_SERVICE_LEVEL=
SHIP_FROM_NAME=
SHIP_FROM_LINE1=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=

# Carrier tracking (doc 05 C6) — the webhook REJECTS everything when the
# secret is unset, which is deliberate: no updates beats unverified ones.
DRX_API_KEY=
DRX_WEBHOOK_SECRET=

# Inventory reserve/consume/release on the order lifecycle (assign/production/
# cancel) is a NO-OP unless this is "1" — on-hand/reserved/available will not
# move with orders until it is set. Off by default during cutover so the
# counts are not trusted before they have been reconciled; set to "1" once
# they are.
INVENTORY_ORDER_FLOW=
