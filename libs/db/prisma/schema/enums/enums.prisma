// ─────────────────────────────────────────────────────────────────────────────
// gwprint — enums
// Every status/type column is an enum (never a free string). Carrier-supplied
// values (e.g. Shipment.trackingStatus) are the exception: external data we
// don't control stays String.
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

/// Job titles, not scopes. A restricted partner is a SELLER/WAREHOUSE with
/// UserAllowedProduct rows — never its own role (that was the legacy
/// "warehouse_external" mistake).
enum UserRole {
  ADMIN
  SELLER
  WAREHOUSE
  /// Runs a warehouse: its staff, stock and order assignments.
  WAREHOUSE_ADMIN
  SUPPORT
  /// Artwork and mockups on orders. No money, no product management.
  DESIGNER
}

/// What happened. The panel maps each to a locale key and an icon, so adding a
/// type means adding a case there — not a new column here.
enum NotificationType {
  INVITE_RECEIVED
  INVITE_ACCEPTED
  ROLE_CHANGED
  BALANCE_TOPPED_UP
  BALANCE_REFUNDED
  TRANSACTION_APPROVED
  TRANSACTION_REJECTED
  ORDER_ASSIGNED
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  WORK_ASSIGNED
  ORDER_ON_HOLD
  /// A label and tracking number now exist for a seller's order — the event a
  /// shop needs to tell its own customer something.
  SHIPPING_LABEL_READY
  /// The carrier moved the parcel. Raised only for outcomes (delivered,
  /// exception, returned), never for every scan along the route.
  TRACKING_UPDATED
  /// The floor is stuck and a human has to clear it (no basket free).
  FULFILLMENT_BLOCKED
  /// A label purchase failed. Money-adjacent, so it is never silent.
  LABEL_PURCHASE_FAILED
  /// A seller asked for money to move (top-up claimed, refund requested) and
  /// somebody with the approve grant has to look at it.
  TRANSACTION_REQUESTED
  /// Someone answered a ticket. Legacy sent NOTHING on ticket events — sellers
  /// refreshed the page to find out whether support had replied.
  TICKET_REPLIED
  /// A ticket was opened, resolved or closed by the other party.
  TICKET_STATUS_CHANGED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

