  TICKET_STATUS_CHANGED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Canonical order lifecycle. Carrier tracking strings live on Shipment.
enum FulfillmentStatus {
  PENDING
  ASSIGNED
  IN_PRODUCTION
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  ON_HOLD
  /// Order refunded to the customer. Kept distinct from CANCELLED so the ~319
  /// legacy "Refund" orders stay reportable as refunds, not plain cancellations.
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TransactionType {
  TOPUP
  ORDER_PAYMENT
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum BasketPositionStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  BROKEN
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory. The legacy system ran THREE parallel stock systems (per-variant,
// finished-goods-by-sku, materials) with zero enums — every status was a free
// string, so "Design problems" and "Design Problems" were different states.
// One system here, one discriminator, and every state checked at compile time.
// ─────────────────────────────────────────────────────────────────────────────

/// What a stock row, movement, receipt line or reservation points at. This is
/// the whole reason there is one inventory system instead of two: a material
/// and a finished SKU differ only in which column is filled.
enum InventoryItemType {
  MATERIAL
  PRODUCT
}

/// Why stock moved. The ledger is append-only, so this is also the vocabulary
/// of the movements page. Movements that TAKE stock away (CONSUME) carry a
/// negative quantity — the sign is what the UI colours red or green.
enum InventoryMovementType {
  RECEIPT
  MANUAL_IMPORT
  MANUAL_ADJUSTMENT
  RESERVE
  RESERVE_RELEASE
  CONSUME
  RETURN
  /// A reservation could not be met — the shortage is recorded so the floor
  /// can see what to order, and cleared by NEEDED_RESOLVED when stock lands.
  NEEDED
  NEEDED_RESOLVED
}

enum ReceiptStatus {
  PENDING
  PARTIAL
  COMPLETE
  REJECTED
}

/// PARTIAL_RECEIVED is what makes receiving across several sessions safe: a
/// shipment can be re-received and only the delta hits stock.
enum ReceiptShipmentStatus {
  PENDING
  PARTIAL_RECEIVED
  RECEIVED
  REJECTED
}

enum ReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
  RETURNED
}

enum BomStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// Where in the build a component is used. Reporting only — it does not
/// change when stock moves.
enum BomStage {
  PRODUCTION
  PACKING
  SHIPPING
  OTHER
}

/// Note there is no unit-of-measure enum to match: the floor types real units
/// ("m", "roll", "kg") and constraining that list only invents work.
enum MaterialType {
  RAW_MATERIAL
  PACKAGING
  SEMI_FINISHED
  CONSUMABLE
  OTHER
}

/// Which way the company's own money moved. Not a seller ledger direction —
/// see ExpenseEntry for why that is a separate system entirely.
enum ExpenseType {
  EXPENSE
  INCOME
}

/// The outcome of ONE delivery attempt, logged so a seller's outage is
/// visible after the fact rather than only a console.warn nobody was
/// watching. See WebhookDelivery.
enum WebhookDeliveryStatus {
  DELIVERED
  FAILED
}
