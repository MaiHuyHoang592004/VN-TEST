/// Seller API keys. Only the SHA-256 hash is stored — hash the presented key
/// and look it up by `keyHash`. (Legacy plaintext keys were hashed on import,
/// so existing integrations keep working without a key rotation.)
model ApiKey {
  id         Int       @id @default(autoincrement())
  userId     String    @map("user_id")
  keyHash    String    @unique @map("key_hash")
  name       String?
  /// Leading chars of the key ("opc_live_a1b2c3d4"), safe to display so a
  /// user can tell two keys apart. The secret half is never stored.
  /// Empty for legacy keys imported before prefixes existed.
  prefix     String    @default("")
  lastUsedAt DateTime? @map("last_used_at")
  /// Rotation and revocation, which the legacy single-key design had no way
  /// to express. Lookup rule everywhere: match keyHash AND revokedAt IS NULL
  /// AND (expiresAt IS NULL OR expiresAt > now()).
  revokedAt  DateTime? @map("revoked_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("api_keys")
}
