model AutomationRule {
  id             String  @id @default(uuid(7))
  organizationId String
  name           String
  enabled        Boolean @default(true)
  priority       Int     @default(0)

  // "ORDER_RECEIVED" in V1 — validated by application schema, not an enum,
  // so a new trigger type never needs a migration.
  trigger String

  // Array of { field, op, values|value } — see apps/worker/src/core/policy/policy-engine.ts.
  conditions Json

  // "ALLOW" | "HOLD" — validated by application schema (policy-engine.ts).
  action String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([organizationId, enabled, priority])
}
