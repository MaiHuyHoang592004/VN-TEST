model InventoryMovement {
  id              String                  @id @default(uuid(7))
  facilityId      String
  inventoryItemId String
  reason          InventoryMovementReason
  onHandDelta     Decimal                 @default(0) @db.Decimal(18, 6)
  reservedDelta   Decimal                 @default(0) @db.Decimal(18, 6)

  // e.g. reserve:<reservationId>, consume:<reservationId>, receipt:<receiptRef>
  idempotencyKey String? @unique

  reservationId String?
  fulfillmentId String?
  actorId       String?
  note          String?

  facility      Facility              @relation(fields: [facilityId], references: [id])
  inventoryItem InventoryItem         @relation(fields: [inventoryItemId], references: [id])
  reservation   InventoryReservation? @relation(fields: [reservationId], references: [id])
  fulfillment   Fulfillment?          @relation(fields: [fulfillmentId], references: [id])
  actor         User?                 @relation("MovementActor", fields: [actorId], references: [id])

  // Append-only: no updatedAt.
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([facilityId, inventoryItemId, createdAt])
  @@index([reservationId])
  @@index([fulfillmentId])
}
