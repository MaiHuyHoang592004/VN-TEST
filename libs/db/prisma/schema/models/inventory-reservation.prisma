model InventoryReservation {
  id                String            @id @default(uuid(7))
  fulfillmentItemId String
  facilityId        String
  inventoryItemId   String
  bomComponentId    String?
  quantity          Decimal           @db.Decimal(18, 6)
  consumedQuantity  Decimal           @default(0) @db.Decimal(18, 6)
  status            ReservationStatus @default(ACTIVE)

  fulfillmentItem FulfillmentItem @relation(fields: [fulfillmentItemId], references: [id])
  facility        Facility        @relation(fields: [facilityId], references: [id])
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  bomComponent    BomComponent?   @relation(fields: [bomComponentId], references: [id])

  movements InventoryMovement[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([fulfillmentItemId, inventoryItemId], where: { status: "ACTIVE" }, map: "one_active_reservation_per_item")
  @@index([facilityId, inventoryItemId, status])
}
