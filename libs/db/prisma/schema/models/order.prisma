model Order {
  id             String @id @default(uuid(7))
  organizationId String
  storeId        String

  externalId    String
  displayNumber String?
  // shopify:{storeId}:{externalId} | csv:{storeId}:{businessKey}
  sourceKey     String

  status OrderStatus @default(OPEN)

  currency            String  @db.VarChar(3)
  fulfillmentCurrency String? @db.VarChar(3)

  channelFinancialStatus String?
  channelUpdatedAt       DateTime? @db.Timestamptz(3)

  customerName  String?
  customerEmail String?

  placedAt    DateTime  @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  closedAt    DateTime? @db.Timestamptz(3)

  correlationId String?

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id])

  shippingAddress  OrderAddress?
  items            OrderItem[]
  fulfillments     Fulfillment[]
  routingDecisions RoutingDecision[]
  exceptions       ExceptionCase[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, sourceKey])
  @@unique([storeId, externalId])
  @@index([organizationId, status, placedAt])
}
