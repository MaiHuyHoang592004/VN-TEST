/// One physical shipment of an order (supports split shipments and reships).
/// `trackingStatus` is the carrier's raw string — external data, not an enum.
model Shipment {
  id             Int       @id @default(autoincrement())
  orderId        Int       @map("order_id")
  provider       String?
  method         String?
  cost           Decimal?  @db.Decimal(12, 2)
  trackingNumber String?   @map("tracking_number")
  trackingStatus String?   @map("tracking_status")
  labelUrl       String?   @map("label_url")
  labelPath      String?   @map("label_path")
  shippedAt      DateTime? @map("shipped_at")

  /// Set once a void succeeds — carrier-side (when the provider confirms it)
  /// or, absent that, at least locally so the record stops claiming a live
  /// label. Buying a NEW label for this shipment's order is a separate,
  /// ordinary purchase; this column only marks that this one no longer counts.
  voidedAt   DateTime? @map("voided_at")
  voidReason String?   @map("void_reason")

  /// The carrier's most recent scan, from the DRX tracking webhook — kept
  /// distinct from `trackingStatus` (a name WE picked, e.g. "delivered") so
  /// a support ticket can show the carrier's own last words verbatim.
  lastScanStatus String?   @map("last_scan_status")
  lastScanDetail String?   @map("last_scan_detail")
  lastScanAt     DateTime? @map("last_scan_at")

  /// The purchase record: parcels used, the provider's raw response, and the
  /// storage key of any stored artefact. This row IS the label log — legacy
  /// kept a separate OrderLabel table whose only real job was holding the
  /// response body for dispute debugging.
  configs Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}
