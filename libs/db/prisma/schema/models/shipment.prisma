model Shipment {
  id            String         @id @default(uuid(7))
  fulfillmentId String
  status        ShipmentStatus @default(PENDING)

  provider String
  service  String?

  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  externalLabelId String?

  // Shopify Fulfillment gid after sync-back.
  externalFulfillmentId String?

  cost     Decimal? @db.Decimal(14, 4)
  currency String?  @db.VarChar(3)

  // Address at label purchase time.
  addressSnapshot Json?
  providerPayload Json?

  shippedAt   DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  voidedAt    DateTime? @db.Timestamptz(3)

  fulfillment Fulfillment    @relation(fields: [fulfillmentId], references: [id])
  items       ShipmentItem[]
  exceptions  ExceptionCase[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([id, fulfillmentId])
  @@unique([provider, trackingNumber], where: { trackingNumber: { not: null } }, map: "shipment_tracking_unique")
  @@index([fulfillmentId])
}
