/// One physical shipment of an order (supports split shipments and reships).
/// `trackingStatus` is the carrier's raw string — external data, not an enum.
model Shipment {
  id             Int       @id @default(autoincrement())
  orderId        Int       @map("order_id")
  provider       String?
  method         String?
  cost           Decimal?  @db.Decimal(12, 2)
  trackingNumber String?   @map("tracking_number")
  trackingStatus String?   @map("tracking_status")
  labelUrl       String?   @map("label_url")
  labelPath      String?   @map("label_path")
  shippedAt      DateTime? @map("shipped_at")

  /// The purchase record: parcels used, the provider's raw response, and the
  /// storage key of any stored artefact. This row IS the label log — legacy
  /// kept a separate OrderLabel table whose only real job was holding the
  /// response body for dispute debugging.
  configs Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}
