model User {
  id           String        @id @default(uuid(7))
  email        String        @unique
  name         String?
  active       Boolean       @default(true)
  platformRole PlatformRole?

  // Shopify staff identity (ID token `sub`), set when the user first opens the embedded app.
  shopifyUserId String? @unique

  organizationMemberships OrganizationMembership[]
  facilityMemberships     FacilityMembership[]
  assignedFulfillments    Fulfillment[]       @relation("FulfillmentAssignee")
  assignedExceptions      ExceptionCase[]     @relation("ExceptionAssignee")
  resolvedExceptions      ExceptionCase[]     @relation("ExceptionResolver")
  inventoryMovements      InventoryMovement[] @relation("MovementActor")
  auditLogs               AuditLog[]          @relation("AuditActor")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
