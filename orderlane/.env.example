# Copy to .env.local. Every value below has a working default or a documented
# fallback, so a fresh clone runs with none of them set except DATABASE_URL.

DATABASE_URL="postgresql://postgres@localhost:5432/orderlane_dev?schema=public"

# Auth. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Object storage. Unset -> the local-disk driver writes to ./.uploads, which is
# what the test suite and a fresh clone use. Set to "s3" to use the S3 driver.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Shipping carrier. Unset -> the deterministic fake carrier, which produces
# stable labels and tracking numbers offline. No third-party account is needed
# to run, demo or test this project.
CARRIER_DRIVER="fake"
CARRIER_API_KEY=""
CARRIER_API_BASE_URL=""
