# Copy to .env.local.
#
# Only DATABASE_URL is required. Everything else has a working default, and a
# fresh clone runs, seeds, tests and demos with no third-party account at all.

DATABASE_URL="postgresql://postgres@localhost:5432/orderlane_dev?schema=public"

# ─── Development conveniences ────────────────────────────────────────────────

# "1" returns the one-time sign-in code in the API response as well as sending
# it, so a local sign-in does not need a mailbox. With no mailer configured the
# code is printed to the server console either way. NEVER set this in production.
AUTH_CODE_ECHO=""

# Set by CI. When it is set, the integration tests refuse to skip themselves:
# a pipeline reporting passing tests having run none of them is worse than a
# red one.
CI=""

# ─── Not read by any code yet ────────────────────────────────────────────────
#
# Listed so the shape of each port is visible, and marked so nobody wastes an
# afternoon setting one and wondering why nothing changed. See "Not built yet"
# in README.md.
#
#   STORAGE_DRIVER        "local" (disk, the default) or "s3"
#   S3_ENDPOINT / S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
#   CARRIER_DRIVER        "fake" (deterministic, offline, the default) or a real carrier
#   CARRIER_API_KEY / CARRIER_API_BASE_URL
#   MAILER_DRIVER         "console" (the default) or a transactional provider
#
# There is deliberately no AUTH_SECRET. Sessions are opaque random tokens looked
# up in a table, not signed documents, so there is no signing key — which means
# one fewer secret to leak, rotate, or accidentally commit.
