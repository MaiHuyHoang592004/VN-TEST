{
  "name": "@orderlane/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'src/tenant-scope.test.ts'",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0"
  },
  "devDependencies": {
    "prisma": "^7.0.0"
  }
}
