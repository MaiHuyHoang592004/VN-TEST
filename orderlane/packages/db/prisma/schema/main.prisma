// Orderlane — schema root.
//
// Multi-file schema. Enums live in enums.prisma, one file per model under
// models/. Two rules hold everywhere:
//
//   1. Every tenant-owned row carries `tenantId` — INCLUDING child rows that
//      could infer it from a parent. Inheriting it through a relation leaves
//      the child table directly queryable without a filter, which is a leak
//      that looks like correct code. Isolation is then enforced once, in the
//      Prisma client extension (packages/db/src/client.ts), never by
//      remembering to add a `where` clause.
//   2. Money is an integer count of minor units plus an explicit currency.
//      Never a float, never a bare number without its currency next to it.
//      See docs/design/ledger.md.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated"

  // The generated client ships TypeScript. `importFileExtension = "ts"` makes
  // its internal imports resolve under `node --experimental-strip-types`,
  // which is what lets the integration tests run against a real database with
  // no build step and no test-runner dependency.
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

// Prisma 7: the connection URL lives in prisma.config.ts, and the runtime
// client is constructed with a driver adapter. Nothing secret is in this file.
datasource db {
  provider = "postgresql"
}
