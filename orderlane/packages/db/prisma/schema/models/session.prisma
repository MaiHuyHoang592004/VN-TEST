/// A signed-in browser.
///
/// Sessions are rows, not JWTs. The earlier design said the opposite, and the
/// reason it changed is worth writing down: in a multi-tenant system the
/// interesting claim is not "this is Ada" but "Ada is an OWNER of Northwind",
/// and that second claim can be revoked. A JWT carrying it stays true until it
/// expires, so removing somebody's access would mean waiting out a token — or
/// building a revocation list, which is a session table with extra steps.
///
/// The cost is one indexed lookup per request. That is a price worth paying to
/// make "remove this person" take effect now.
model Session {
  id String @id @default(cuid())

  /// SHA-256 of the token in the cookie. The token itself is 32 random bytes
  /// this system generated and is never stored — same reasoning as ApiKey, and
  /// it means a database leak does not hand anybody a live session.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Recorded so a person can recognise their own sessions in a list and end
  /// one they do not. Never used for authorisation: both are client-supplied.
  userAgent String? @map("user_agent")
  ip        String?

  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  /// Set rather than deleted, so "signed out at 14:02" survives the sign-out.
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId, createdAt])
  /// Expired-session cleanup scans this.
  @@index([expiresAt])
  @@map("sessions")
}

/// A one-time code sent to an email address.
///
/// Used for passwordless sign-in and for proving an address at sign-up. Only
/// the hash is stored: an attacker with the database still has to guess a
/// six-digit code inside its lifetime, against a counter that stops them.
model EmailCode {
  id       String          @id @default(cuid())
  email    String
  codeHash String          @map("code_hash")
  purpose  EmailCodePurpose

  /// Wrong guesses. A six-digit code is only safe with a small ceiling on
  /// tries — without one it is a million-guess race the attacker wins.
  attempts Int @default(0)

  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("email_codes")
}
