/// A person. Deliberately NOT tenant-scoped: one person can work for several
/// merchants, which is why authorisation lives on Membership rather than on a
/// role column here. A role column would have made "which tenant?" ambiguous
/// the first time somebody joined a second one.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  imageUrl     String?  @map("image_url")
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  /// Set only for the password sign-in method. Null is normal: a person who
  /// only ever uses email codes has no password to leak.
  emailVerifiedAt DateTime? @map("email_verified_at")

  memberships   Membership[]
  authAccounts  AuthAccount[]
  sessions      Session[]
  importJobs    ImportJob[]
  transitionLog TransitionLog[]

  @@map("users")
}

/// A federated identity linked to this user. No provider is implemented yet —
/// the table exists because linking one must not require a schema change, and
/// because "sign in with X" has to attach to an existing user rather than
/// silently creating a second one for the same person.
model AuthAccount {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}
